# AIRoute environment variables.
#
# AIRoute never reads this file itself. npm scripts pass it to node with
# `node --env-file-if-exists=.env` (see the "start" / "dev" scripts), so keys
# below become real environment variables whenever you start a dev server or
# `npm run start`. Never commit your real .env file (it is gitignored).
#
# Copy this file:   cp .env.example .env
# Then fill in only the sources you actually use.

# --- Z.AI (open.bigmodel.cn) -------------------------------------------------
# Required by source type "zai". If unset, the loader logs
# "source 'zai' disabled: no key" and skips the source at startup.
ZAI_API_KEY=

# --- OpenRouter --------------------------------------------------------------
# Required by source type "openrouter". Behavior identical to ZAI_API_KEY.
OPENROUTER_API_KEY=

# --- Optional overrides ------------------------------------------------------
# Path to the config file used by `airoute serve` / `airoute models`
# (default: config/airoute.json). Can also be passed via --config.
#AIRROUTE_CONFIG=config/airoute.json

# Verbose logging ("debug" enables debug lines; anything else stays quiet).
#AIRROUTE_LOG=debug
